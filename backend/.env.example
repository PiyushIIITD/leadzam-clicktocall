# Copy to .env (git-ignored) and adjust.

PORT=3000

# Path to the Firebase service-account JSON (downloaded from Firebase console
# -> Project settings -> Service accounts -> Generate new private key).
# Keep this file OUTSIDE git. backend/secrets/ is git-ignored.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Optional: hard-code a device token instead of registering from the app.
# FCM_DEVICE_TOKEN=
